{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/env": "./src/config/env.ts",
    "./config/env.server": "./src/config/env.server.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/schema/api-error-record.test.ts src/migrations/organization-account-memberships.test.ts src/seed/admin.test.ts src/repositories/api-error-records/api-error-records.test.ts src/repositories/organizations/organizations.test.ts src/repositories/events/event-organization-ownership.test.ts src/repositories/staff-invitations/staff-invitations.test.ts src/repositories/staff/staff-organization-management.test.ts src/repositories/orders/delete-stale-pending-orders.test.ts src/repositories/orders/find-orders-paginated-by-user-document-id.test.ts src/repositories/orders/delete-pending-order-by-document-id-and-user-id.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:push": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle-dev.config.ts",
    "db:seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.3",
    "@repo/types": "workspace:*",
    "@repo/validators": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "26.1.2",
    "drizzle-kit": "0.31.1",
    "tsx": "4.19.4",
    "typescript": "7.0.2"
  }
}
