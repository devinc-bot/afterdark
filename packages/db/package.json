{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/env": "./src/config/env.ts",
    "./config/env.server": "./src/config/env.server.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "pnpm -C ../.. exec vitest run db",
    "db:generate": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:push": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle-dev.config.ts",
    "db:seed:development": "tsx src/seed/development/index.ts",
    "db:seed:production": "tsx src/seed/production/index.ts"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "@repo/validators": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "26.1.2",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.1",
    "tsx": "4.19.4",
    "typescript": "7.0.2"
  }
}
