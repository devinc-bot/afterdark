# API runtime configuration for the production VPS. The direct migration URL belongs only in
# production.migrator.env, not in this file.
DATABASE_URL=REPLACE_WITH_PRODUCTION_NEON_POOLED_URL
PORT=3000
NODE_ENV=production

JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_PRODUCTION_REFRESH_TOKEN_SECRET
API_PUBLIC_URL=https://api.example.com
WEB_URL=https://example.com
DASHBOARD_URL=https://dashboard.example.com
ADMIN_URL=https://admin.example.com
TRUST_PROXY_HOPS=1

GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=REPLACE_WITH_PRODUCTION_RESEND_API_KEY
MAIL_FROM=REPLACE_WITH_PRODUCTION_MAIL_FROM
MAIL_SMOKE_TO=REPLACE_WITH_PRODUCTION_MAIL_SMOKE_TO

MERCADOPAGO_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_TEST_MODE=false

R2_ACCOUNT_ID=REPLACE_WITH_PRODUCTION_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_PRODUCTION_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_PRODUCTION_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_PRODUCTION_R2_BUCKET
R2_PUBLIC_BASE_URL=https://REPLACE_WITH_PRODUCTION_R2_PUBLIC_HOST
R2_UPLOAD_PREFIX=images
