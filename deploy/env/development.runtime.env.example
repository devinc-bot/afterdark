# API and migration runtime configuration. Do not use these marker values in a deployed service.
DATABASE_URL=postgresql://REPLACE_WITH_LOCAL_DATABASE_USER:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@postgres:5432/app
DATABASE_MIGRATION_URL=postgresql://REPLACE_WITH_LOCAL_DATABASE_USER:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@postgres:5432/app
PORT=3000
NODE_ENV=development

JWT_SECRET=REPLACE_WITH_LOCAL_JWT_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_LOCAL_REFRESH_TOKEN_SECRET
API_PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
TRUST_PROXY_HOPS=0

GOOGLE_CLIENT_ID=REPLACE_WITH_LOCAL_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_LOCAL_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=REPLACE_WITH_LOCAL_RESEND_API_KEY
MAIL_FROM=REPLACE_WITH_LOCAL_MAIL_FROM
MAIL_SMOKE_TO=REPLACE_WITH_LOCAL_MAIL_SMOKE_TO

MERCADOPAGO_ACCESS_TOKEN=REPLACE_WITH_LOCAL_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_LOCAL_MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_TEST_MODE=true

R2_ACCOUNT_ID=REPLACE_WITH_LOCAL_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_LOCAL_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_LOCAL_R2_BUCKET
R2_PUBLIC_BASE_URL=https://REPLACE_WITH_LOCAL_R2_PUBLIC_HOST
R2_UPLOAD_PREFIX=images
