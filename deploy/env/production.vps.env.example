# Compose selection for the production VPS. Replace every image with an immutable GHCR digest.
ADMIN_HOST=admin.example.com
ADMIN_IMAGE=ghcr.io/devinc-bot/app-admin@sha256:REPLACE_WITH_PRODUCTION_ADMIN_DIGEST
API_HOST=api.example.com
API_IMAGE=ghcr.io/devinc-bot/app-api@sha256:REPLACE_WITH_PRODUCTION_API_DIGEST
# Replace with an absolute restricted path on the production VPS.
API_RUNTIME_ENV_FILE=./deploy/env/production.runtime.env.example
CADDY_IMAGE=caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
DASHBOARD_HOST=dashboard.example.com
DASHBOARD_IMAGE=ghcr.io/devinc-bot/app-dashboard@sha256:REPLACE_WITH_PRODUCTION_DASHBOARD_DIGEST
MIGRATOR_IMAGE=ghcr.io/devinc-bot/app-migrator@sha256:REPLACE_WITH_PRODUCTION_MIGRATOR_DIGEST
MIGRATOR_RUNTIME_ENV_FILE=./deploy/env/production.migrator.env.example
DEPLOY_ENVIRONMENT=production
WEB_HOST=example.com
WEB_IMAGE=ghcr.io/devinc-bot/app-web@sha256:REPLACE_WITH_PRODUCTION_WEB_DIGEST
