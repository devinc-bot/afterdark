# Compose selection for the staging VPS. Replace every image with an immutable GHCR digest.
ADMIN_HOST=admin.staging.example.com
ADMIN_IMAGE=ghcr.io/devinc-bot/app-admin@sha256:REPLACE_WITH_STAGING_ADMIN_DIGEST
API_HOST=api.staging.example.com
API_IMAGE=ghcr.io/devinc-bot/app-api@sha256:REPLACE_WITH_STAGING_API_DIGEST
# Replace with an absolute restricted path on the staging VPS.
API_RUNTIME_ENV_FILE=./deploy/env/staging.runtime.env.example
CADDY_IMAGE=caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
DASHBOARD_HOST=dashboard.staging.example.com
DASHBOARD_IMAGE=ghcr.io/devinc-bot/app-dashboard@sha256:REPLACE_WITH_STAGING_DASHBOARD_DIGEST
MIGRATOR_IMAGE=ghcr.io/devinc-bot/app-migrator@sha256:REPLACE_WITH_STAGING_MIGRATOR_DIGEST
MIGRATOR_RUNTIME_ENV_FILE=./deploy/env/staging.migrator.env.example
DEPLOY_ENVIRONMENT=staging
WEB_HOST=staging.example.com
WEB_IMAGE=ghcr.io/devinc-bot/app-web@sha256:REPLACE_WITH_STAGING_WEB_DIGEST
