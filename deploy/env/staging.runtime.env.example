# API runtime configuration for the staging VPS. The direct migration URL belongs only in
# staging.migrator.env, not in this file.
DATABASE_URL=REPLACE_WITH_STAGING_NEON_POOLED_URL
PORT=3000
NODE_ENV=production

JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_STAGING_REFRESH_TOKEN_SECRET
API_PUBLIC_URL=https://api.staging.example.com
WEB_URL=https://staging.example.com
DASHBOARD_URL=https://dashboard.staging.example.com
ADMIN_URL=https://admin.staging.example.com
TRUST_PROXY_HOPS=1

GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=REPLACE_WITH_STAGING_RESEND_API_KEY
MAIL_FROM=REPLACE_WITH_STAGING_MAIL_FROM
MAIL_SMOKE_TO=REPLACE_WITH_STAGING_MAIL_SMOKE_TO

MERCADOPAGO_ACCESS_TOKEN=REPLACE_WITH_STAGING_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_STAGING_MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_TEST_MODE=true

R2_ACCOUNT_ID=REPLACE_WITH_STAGING_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_STAGING_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_STAGING_R2_BUCKET
R2_PUBLIC_BASE_URL=https://REPLACE_WITH_STAGING_R2_PUBLIC_HOST
R2_UPLOAD_PREFIX=images
